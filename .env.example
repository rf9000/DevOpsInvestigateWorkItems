# Azure DevOps Configuration (required)
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_ORG=your-org-name
AZURE_DEVOPS_PROJECT=your-project-name
FEATURE_WORK_ITEM_IDS=12345,67890
TARGET_REPO_PATH=/repo

# Optional: Polling interval in minutes (default: 15)
# POLL_INTERVAL_MINUTES=15

# Optional: Max investigations per day (default: 5)
# MAX_INVESTIGATIONS_PER_DAY=5

# Optional: Claude model for the investigation (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional: Path to AI prompt file (default: src/prompts/investigate-bug.md)
# PROMPT_PATH=src/prompts/investigate-bug.md

# Optional: Only investigate bugs assigned to these people (comma-separated, default: all)
# ASSIGNED_TO_FILTER=Alice Smith,Bob Jones

# Optional: Tag that triggers reinvestigation (default: agent investigate)
# REINVESTIGATE_TAG=agent investigate

# Optional: State file directory (default: .state)
# STATE_DIR=.state

# Optional: Cost ledger, one JSON line per processed work item with USD and token spend.
# Read by the monitor dashboard. Dry runs never write to it. (default: <STATE_DIR>/cost-ledger.jsonl)
# COST_LOG_PATH=.state/cost-ledger.jsonl

# Optional: Pipeline. legacy = one investigation pass; triage = cheap triage, then a deep
# dive only for complete bugs/investigations (default: legacy)
# PIPELINE_VARIANT=legacy

# Optional: Model for the triage pass; the deep dive uses CLAUDE_MODEL (default: claude-haiku-5-5)
# TRIAGE_MODEL=claude-haiku-5-5

# Optional: Prompts for the triage pipeline
# TRIAGE_PROMPT_PATH=src/prompts/triage.md
# DEEP_PROMPT_PATH=src/prompts/investigate-deep.md
